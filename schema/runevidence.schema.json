{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "description": "Path relative to the manifest's folder, using forward slashes.",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free-form label, e.g. dataset, config, checkpoint, metrics, log.",
          "title": "Kind"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Run that produced this file.",
          "title": "Run Id"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "path"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Id",
          "type": "string"
        },
        "claim": {
          "description": "The statement being made, in plain words.",
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "supports": {
          "description": "IDs of results, artifacts or runs backing the claim.",
          "items": {
            "type": "string"
          },
          "title": "Supports",
          "type": "array"
        },
        "contradicts": {
          "description": "IDs of results, artifacts or runs that cut against it.",
          "items": {
            "type": "string"
          },
          "title": "Contradicts",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the claim is made, e.g. 'README.md#results'.",
          "title": "Source"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "claim"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Project",
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/RelationshipType"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "source",
        "target",
        "type"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "RelationshipType": {
      "enum": [
        "produced_by",
        "input_to",
        "result_of",
        "reported_in",
        "derived_from",
        "supports",
        "contradicts"
      ],
      "title": "RelationshipType",
      "type": "string"
    },
    "Result": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Id",
          "type": "string"
        },
        "run_id": {
          "description": "Run this result belongs to.",
          "title": "Run Id",
          "type": "string"
        },
        "name": {
          "description": "What was measured, e.g. 'accuracy' or 'val_loss'.",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Artifact the value was read from (e.g. a metrics file).",
          "title": "Artifact Id"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RFC 6901 JSON Pointer into a .json artifact (e.g. '/eval/accuracy'). When set, the recorded value is compared against the file.",
          "title": "Locator"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "run_id",
        "name"
      ],
      "title": "Result",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "params": {
          "additionalProperties": true,
          "description": "Hyperparameters or settings, free-form.",
          "title": "Params",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "title": "Run",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/Project"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/Run"
      },
      "title": "Runs",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/Result"
      },
      "title": "Results",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Evidence",
      "type": "array"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/Relationship"
      },
      "title": "Relationships",
      "type": "array"
    }
  },
  "required": [
    "project"
  ],
  "title": "Manifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runevidence:manifest:0.1"
}
